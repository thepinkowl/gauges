# Copy to android/keystore.properties and fill in from Bitwarden.
# keystore.properties is gitignored — never commit it, and never commit the .jks itself.
#
# Bitwarden item: "Gauges — Android upload keystore"
#   - the .jks lives there as a file attachment
#   - storePassword / keyAlias / keyPassword live there as custom fields
# Download the .jks to somewhere outside this repo (e.g. ~/keys/) and point
# storeFile at it. An absolute path is used as-is; a relative path resolves
# against the android/ directory.

storeFile=/Users/you/keys/gauges-upload.jks
storePassword=
keyAlias=upload
keyPassword=
